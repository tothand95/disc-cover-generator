{
  "name": "disc-cover-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client-side, static PDF generator for DVD/Blu-Ray/CD covers.",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
